# Configuración del Servidor
PORT=3000

# Credenciales de Spotify (Obtener en https://developer.spotify.com/dashboard/)
SPOTIFY_CLIENT_ID=tu_client_id_aqui
SPOTIFY_CLIENT_SECRET=tu_client_secret_aqui
SPOTIFY_REDIRECT_URI=http://localhost:3000/auth/spotify/callback

# Credenciales de Google / YouTube (Obtener en Google Cloud Console)
YOUTUBE_CLIENT_ID=tu_client_id_aqui
YOUTUBE_CLIENT_SECRET=tu_client_secret_aqui
YOUTUBE_REDIRECT_URI=http://localhost:3000/auth/youtube/callback
